#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a6fc4b98e70 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a6fc4b99000 .scope module, "tb_half_adder" "tb_half_adder" 3 2;
 .timescale -9 -12;
v0x5a6fc4bac8e0_0 .var "a", 0 0;
v0x5a6fc4bac9a0_0 .var "b", 0 0;
v0x5a6fc4baca70_0 .net "carry", 0 0, L_0x5a6fc4bacda0;  1 drivers
v0x5a6fc4bacb70_0 .net "sum", 0 0, L_0x5a6fc4bacc40;  1 drivers
S_0x5a6fc4b5f500 .scope module, "dut" "half_adder" 3 9, 4 1 0, S_0x5a6fc4b99000;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
L_0x5a6fc4bacc40 .functor XOR 1, v0x5a6fc4bac8e0_0, v0x5a6fc4bac9a0_0, C4<0>, C4<0>;
L_0x5a6fc4bacda0 .functor AND 1, v0x5a6fc4bac8e0_0, v0x5a6fc4bac9a0_0, C4<1>, C4<1>;
v0x5a6fc4b5f750_0 .net "a", 0 0, v0x5a6fc4bac8e0_0;  1 drivers
v0x5a6fc4bac640_0 .net "b", 0 0, v0x5a6fc4bac9a0_0;  1 drivers
v0x5a6fc4bac700_0 .net "carry", 0 0, L_0x5a6fc4bacda0;  alias, 1 drivers
v0x5a6fc4bac7a0_0 .net "sum", 0 0, L_0x5a6fc4bacc40;  alias, 1 drivers
    .scope S_0x5a6fc4b99000;
T_0 ;
    %vpi_call/w 3 17 "$dumpfile", "half_adder.vcd" {0 0 0};
    %vpi_call/w 3 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a6fc4b99000 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5a6fc4b99000;
T_1 ;
    %vpi_call/w 3 21 "$monitor", "a = %b | b = %b | sum = %b | carry = %b", v0x5a6fc4bac8e0_0, v0x5a6fc4bac9a0_0, v0x5a6fc4bacb70_0, v0x5a6fc4baca70_0 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5a6fc4b99000;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a6fc4bac8e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a6fc4bac9a0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a6fc4bac8e0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a6fc4bac9a0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a6fc4bac8e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a6fc4bac9a0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a6fc4bac8e0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a6fc4bac9a0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 30 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb_half_adder.v";
    "half_adder.v";
